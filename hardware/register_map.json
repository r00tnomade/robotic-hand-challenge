{
  "device": "Inspire_RH56DFTP",
  "protocol": "Modbus_TCP",
  "connection": {
    "default_ip": "192.168.11.210",
    "default_port": 6000,
    "slave_id": 1
  },
  "register_blocks": {
    "system_config": {
      "start_address": 1000,
      "description": "System control, device ID, and configuration parameters",
      "registers": {
        "hand_id": { "address": 1000, "size": 1, "access": "W/R", "desc": "ID of the dexterous hand (default: 1)" },[cite: 20]
        "clear_error": { "address": 1004, "size": 1, "access": "W/R", "desc": "Clear error flags (write 1)" },[cite: 20, 22]
        "save_flash": { "address": 1005, "size": 1, "access": "W/R", "desc": "Save parameters to Flash (write 1)" }[cite: 20, 22]
      }
    },
    "control_defaults": {
      "start_address": 1032,
      "description": "Power-on default speeds and force thresholds for 6 DOFs",
      "registers": {
        "default_speed_set": { "address": 1032, "size": 12, "access": "W/R", "units": "short, 0-1000" },[cite: 20]
        "default_force_set": { "address": 1044, "size": 12, "access": "W/R", "units": "short, 0-3000" }[cite: 20]
      }
    },
    "actuator_control": {
      "start_address": 1474,
      "description": "Real-time command setpoints for actuators and angles",
      "registers": {
        "pos_set": { "address": 1474, "size": 12, "access": "W/R", "units": "short, 0-2000 stroke" },[cite: 20]
        "angle_set": { "address": 1486, "size": 12, "access": "W/R", "units": "short, -1 or 0-1000" },[cite: 20]
        "force_set": { "address": 1498, "size": 12, "access": "W/R", "units": "short, 0-3000" },[cite: 20]
        "speed_set": { "address": 1522, "size": 12, "access": "W/R", "units": "short, 0-1000" }[cite: 20]
      }
    },
    "actuator_feedback": {
      "start_address": 1534,
      "description": "Real-time telemetry and feedback from the 6 DOFs",
      "registers": {
        "pos_act": { "address": 1534, "size": 12, "access": "RO", "units": "short, 0-2000" },[cite: 20]
        "angle_act": { "address": 1546, "size": 12, "access": "RO", "units": "short, 0-1000" },[cite: 20]
        "force_act": { "address": 1582, "size": 12, "access": "RO", "units": "short, -4000 to 4000 g" },[cite: 20, 28]
        "current": { "address": 1594, "size": 12, "access": "RO", "units": "short, 0-2000 mA" },[cite: 20, 28]
        "error": { "address": 1606, "size": 6, "access": "RO", "units": "byte flag" },[cite: 21]
        "temp": { "address": 1618, "size": 6, "access": "RO", "units": "byte, Celsius" }[cite: 21]
      }
    },
    "tactile_sensors": {
      "start_address": 3000,
      "description": "High-resolution tactile pressure arrays (16-bit integers, values 0-4095)",
      "registers": {
        "little_finger_tip": { "address": 3000, "size": 18, "access": "RO", "layout": "3x3" },[cite: 30]
        "little_finger_nail": { "address": 3018, "size": 192, "access": "RO", "layout": "12x8" },[cite: 30]
        "little_finger_pad": { "address": 3210, "size": 160, "access": "RO", "layout": "10x8" },[cite: 30]
        "ring_finger_tip": { "address": 3370, "size": 18, "access": "RO", "layout": "3x3" },[cite: 30]
        "ring_finger_nail": { "address": 3388, "size": 192, "access": "RO", "layout": "12x8" },[cite: 30]
        "ring_finger_pad": { "address": 3580, "size": 160, "access": "RO", "layout": "10x8" },[cite: 30]
        "middle_finger_tip": { "address": 3740, "size": 18, "access": "RO", "layout": "3x3" },[cite: 30]
        "middle_finger_nail": { "address": 3758, "size": 192, "access": "RO", "layout": "12x8" },[cite: 30]
        "middle_finger_pad": { "address": 3950, "size": 160, "access": "RO", "layout": "10x8" },[cite: 30]
        "index_finger_tip": { "address": 4110, "size": 18, "access": "RO", "layout": "3x3" },[cite: 30]
        "index_finger_nail": { "address": 4128, "size": 192, "access": "RO", "layout": "12x8" },[cite: 30]
        "index_finger_pad": { "address": 4320, "size": 160, "access": "RO", "layout": "10x8" },[cite: 30]
        "thumb_tip": { "address": 4480, "size": 18, "access": "RO", "layout": "3x3" },[cite: 30]
        "thumb_nail": { "address": 4498, "size": 192, "access": "RO", "layout": "12x8" },[cite: 30]
        "thumb_middle": { "address": 4690, "size": 18, "access": "RO", "layout": "3x3" },[cite: 30]
        "thumb_pad": { "address": 4708, "size": 192, "access": "RO", "layout": "12x8" },[cite: 30]
        "palm": { "address": 4900, "size": 224, "access": "RO", "layout": "8x14" }[cite: 30]
      }
    }
  }
}